# ============================================================
# FaceHR - Backend Environment Variables
# Copy this file to `.env` in the `server/` folder and fill in.
# NEVER commit real secrets. In production set these in the Render dashboard.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas connection string recommended in production)
# Include the database name in the path, e.g.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/facehr?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/facehr

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Maximum authenticated API requests per IP per 15 minutes (default 600).
# Sign-in attempts have their own stricter limit.
API_RATE_LIMIT=600

# Allowed frontend origin for CORS (comma separated for multiple).
# Production: your Vercel URL, e.g. https://facehr.vercel.app
CLIENT_URL=http://localhost:5173

# Public base URL used when building absolute URLs to uploaded assets.
# Production: your Render backend origin, e.g. https://facehr-api.onrender.com
UPLOAD_BASE_URL=http://localhost:5000

# Directory where uploaded photos/documents are written.
# Local: leave unset (defaults to server/uploads).
# Render: point this at a mounted persistent disk, e.g. /var/data/uploads
# UPLOAD_DIR=/var/data/uploads

# Face recognition matching threshold (Euclidean distance, lower = stricter)
FACE_MATCH_THRESHOLD=0.6

# Face-api model directory (relative to server/ folder)
FACE_MODELS_PATH=face-models

# Office start time used to compute "Late" status (24h format)
OFFICE_START_TIME=09:30

# Working hours below which a day counts as "Half Day"
HALF_DAY_THRESHOLD_HOURS=4

# Seed a default admin from env on first start (only applied when NO admin exists).
# Set strong, non-default values in production.
ADMIN_EMAIL=admin@facehr.com
ADMIN_NAME=Super Admin 
ADMIN_PASSWORD=Admin@123

# Company name shown in emails and UI defaults
COMPANY_NAME=FaceHR

# Default attendance location (used for geofence defaults)
ATTENDANCE_LOCATION_NAME=Nuvox Technologies
ATTENDANCE_LOCATION_LATITUDE=13.0866182
ATTENDANCE_LOCATION_LONGITUDE=80.1916159

# SMTP mail (optional - used to email new employee login credentials).
# Leave blank to disable outbound email; the app then shows the generated
# password in the admin UI instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# Frontend Environment Variables (.env in client/) - see client/.env.example
# ============================================================
# VITE_API_BASE_URL=/api            (default; use full URL in production)
# VITE_UPLOAD_BASE_URL=             (Render origin; auto-derived if empty)
